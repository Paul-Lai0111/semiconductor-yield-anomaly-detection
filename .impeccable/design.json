      "name": "Readout Table",
      "kind": "card",
      "refersTo": "readout-table",
      "description": "Headline numbers as a spec table: muted label, tabular value, muted note.",
      "html": "<table class=\"ds-readout\"><tr><th>Inspection queue</th><td><span class=\"ds-v\">62 <small>of 314 units</small></span><span class=\"ds-n\">20% budget; ties broken by unit ID</span></td></tr><tr><th>Recorded failures found</th><td><span class=\"ds-v\">5 <small>of 17</small></span><span class=\"ds-n\">Random inspection: 3.4 expected</span></td></tr></table>",
      "css": ".ds-readout{font-family:'Public Sans',sans-serif;width:100%;border-collapse:collapse;background:#F4F6F7;border:1px solid #CBD1D6;border-radius:6px;overflow:hidden;font-variant-numeric:tabular-nums;color:#1E2328;font-size:15px}.ds-readout th{text-align:left;font-weight:500;color:#5B656E;font-size:0.82rem;padding:12px 16px;border-bottom:1px solid #CBD1D6;width:36%;vertical-align:top}.ds-readout td{padding:10px 16px 12px;border-bottom:1px solid #CBD1D6}.ds-readout tr:last-child th,.ds-readout tr:last-child td{border-bottom:0}.ds-v{font-size:1.45rem;font-weight:650;letter-spacing:-0.01em}.ds-v small{font-size:0.9rem;font-weight:500;color:#5B656E}.ds-n{display:block;font-size:0.82rem;color:#5B656E;margin-top:2px}"
